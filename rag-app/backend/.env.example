GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATOR_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=your_groq_api_key_here
GROQ_GENERATOR_MODEL=qwen/qwen3.8-27b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents

EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
SPARSE_MODEL_NAME=Qdrant/bm25

CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

FIRST_STAGE_LIMIT=40
RERANK_TOP_K=6
QUERY_EXPANSION_VARIANT_COUNT=3
QUERY_EXPANSION_SIMILARITY_THRESHOLD=0.80
OFF_TOPIC_SCORE_THRESHOLD=0.15
MMR_LAMBDA=0.5
MMR_POOL_SIZE=15

DATA_DIR=data
UPLOADS_DIR=data/uploads
REGISTRY_PATH=data/registry/documents.json
TRACE_SUCCESS_LOG_PATH=data/traces/successful_traces.jsonl
TRACE_FAILURE_LOG_PATH=data/traces/failed_traces.jsonl
SUCCESS_LOG_PATH=data/logs/success.log
FAILURE_LOG_PATH=data/logs/failure.log

# Optional -- self-hosted Langfuse observability (see docker-compose.yml).
# Leave LANGFUSE_ENABLED=false (or unset) to run with no observability
# dependency at all. When true, the keys below must match the
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY / LANGFUSE_INIT_PROJECT_SECRET_KEY set in
# docker-compose.yml, which auto-provisions a project with exactly these
# keys on the Langfuse container's first boot.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_HOST=http://localhost:3001
